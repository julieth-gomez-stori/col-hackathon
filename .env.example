PORT=8787
AWS_REGION=us-east-1
DYNAMODB_FORMS_TABLE=mvp-hackaton
DYNAMODB_RESPONSES_TABLE=mvp-hackaton-responses

# Uses the default AWS credential chain (~/.aws). Do not commit secrets.
# Optional DynamoDB Local:
# AWS_ENDPOINT=http://localhost:8000
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# Server-only. Do not prefix with VITE_ (that would leak the key in the browser bundle).
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.6-flash
